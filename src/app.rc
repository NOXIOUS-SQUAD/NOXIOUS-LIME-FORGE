#include "resource.h"
#include <windows.h>

IDI_ICON1 ICON "assets/icon.ico"

1 RT_MANIFEST "src/app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,1,0,0
 PRODUCTVERSION 1,1,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "LimeForge"
            VALUE "FileDescription", "LimeForge - Optimizador local para Windows"
            VALUE "FileVersion", "1.1.0.0"
            VALUE "InternalName", "LimeForge"
            VALUE "LegalCopyright", "Uso local y personal"
            VALUE "OriginalFilename", "LimeForge.exe"
            VALUE "ProductName", "LimeForge"
            VALUE "ProductVersion", "1.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
